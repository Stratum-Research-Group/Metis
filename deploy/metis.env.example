# Metis Sovereign Environment Configuration
# File mode should be 0600

# Network & Host Binding
HESTIA_HOST=127.0.0.1
HESTIA_PORT=8080
KYBERNETES_HOST=127.0.0.1
KYBERNETES_PORT=8081
PROSOPON_HOST=127.0.0.1
PROSOPON_PORT=8000

# Security Tokens (Auto-loaded if left blank via data/.host_owner_token)
# HESTIA_SERVICE_TOKEN=
# KYBERNETES_ADMIN_TOKEN=
# KYBERNETES_SERVICE_TOKEN=

# Remote Access Configuration (Pyle)
# Set to true to bind Prosopon to 0.0.0.0 for LAN phone pairing
PROSOPON_LAN=false
# Set to true to enable self-signed TLS for mobile microphone access
PROSOPON_TLS=false

# Offline Ingestion Guards
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
