# Metis Sovereign Environment Configuration Template
# Copy to deploy/metis.env and set permissions: chmod 0600 deploy/metis.env
# NEVER commit deploy/metis.env with real tokens to version control.

# Network & Host Binding
HESTIA_HOST=127.0.0.1
HESTIA_PORT=8080
KYBERNETES_HOST=127.0.0.1
KYBERNETES_PORT=8081
PROSOPON_HOST=127.0.0.1
PROSOPON_PORT=8000

# Service Authentication Tokens (Generate distinct 48-hex tokens: openssl rand -hex 24)
HESTIA_SERVICE_TOKEN="<GENERATE_RANDOM_48_HEX_TOKEN>"
KYBERNETES_SERVICE_TOKEN="<GENERATE_RANDOM_48_HEX_TOKEN>"

# Remote Access Configuration (Pyle)
# Set to true to bind Prosopon to 0.0.0.0 for LAN phone pairing
PROSOPON_LAN=false
# Set to true to enable self-signed TLS for mobile microphone access
PROSOPON_TLS=false

# Offline Ingestion Guards
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
