                },
                "tau": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/probability"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "fallback": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "release_gate": {
                  "type": "string"
                }
              }
