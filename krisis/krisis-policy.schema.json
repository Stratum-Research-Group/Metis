{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krisis-policy.schema.json",
  "title": "Krisis policy manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "schema_version",
    "status",
    "conventions",
    "governance",
    "id_assignment",
    "reason_enum",
    "reason_precedence",
    "profiles",
    "class_routing",
    "n1_handling",
    "budgets",
    "invalidation_events",
    "audit_card",
    "retention",
    "candidate_only_reasons",
    "reason_mapping",
    "generation_policy"
  ],
  "properties": {
    "manifest_id": {
      "const": "krisis-policy-0.1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "retired"
      ]
    },
    "conventions": {
      "type": "object",
      "required": [
        "number_format",
        "score_arithmetic",
        "canonical_json"
      ],
      "properties": {
        "number_format": {
          "type": "string"
        },
        "score_arithmetic": {
          "type": "string"
        },
        "canonical_json": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "solo_mode",
        "roles",
        "sealed_test",
        "approval_lag_hours",
        "evaluation_claim",
        "external_release_gate"
      ],
      "properties": {
        "solo_mode": {
          "type": "boolean"
        },
        "roles": {
          "type": "object",
          "required": [
            "tuning",
            "approval",
            "labeling",
            "independence_rule"
          ],
          "properties": {
            "tuning": {
              "type": "string",
              "minLength": 1
            },
            "approval": {
              "type": "string",
              "minLength": 1
            },
            "labeling": {
              "type": "string",
              "minLength": 1
            },
            "independence_rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sealed_test": {
          "type": "object",
          "required": [
            "hash_recorded_before_tuning",
            "sha256",
            "protocol_sha256",
            "sealed_at_utc",
            "custodian",
            "final_test_access_count"
          ],
          "properties": {
            "hash_recorded_before_tuning": {
              "type": "boolean"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocol_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sealed_at_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "custodian": {
              "type": [
                "string",
                "null"
              ]
            },
            "final_test_access_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "approval_lag_hours": {
          "type": "integer",
          "minimum": 0
        },
        "evaluation_claim": {
          "enum": [
            "internal_only_until_independent_final_test",
            "independent_final_test_passed"
          ]
        },
        "external_release_gate": {
          "type": "object",
          "required": [
            "required",
            "independent_hidden_test_custodian",
            "blinded_human_adjudicator_outside_stack_owner",
            "protocol_and_primary_metric_committed_before_tuning",
            "one_final_test_access",
            "immutable_access_and_decision_log",
            "retire_test_after_failed_final_access",
            "solo_fallback_claim"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "independent_hidden_test_custodian": {
              "const": true
            },
            "blinded_human_adjudicator_outside_stack_owner": {
              "const": true
            },
            "protocol_and_primary_metric_committed_before_tuning": {
              "const": true
            },
            "one_final_test_access": {
              "const": true
            },
            "immutable_access_and_decision_log": {
              "const": true
            },
            "retire_test_after_failed_final_access": {
              "const": true
            },
            "solo_fallback_claim": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "id_assignment": {
      "type": "string"
    },
    "reason_enum": {
      "const": [
        "NO_AUTHORIZED_CANDIDATE",
        "NO_VALID_CANDIDATE",
        "QUALITY_BELOW_THRESHOLD",
        "VERIFIER_UNAVAILABLE",
        "BUDGET_EXHAUSTED",
        "STALE",
        "SCHEMA_INVALID",
        "UPSTREAM_GENERATION_FAILED",
        "PROFILE_UNAVAILABLE",
        "FEATURE_INVALID",
        "CANCELLED"
      ]
    },
    "reason_precedence": {
      "const": [
        "CANCELLED",
        "SCHEMA_INVALID",
        "NO_AUTHORIZED_CANDIDATE",
        "VERIFIER_UNAVAILABLE",
        "PROFILE_UNAVAILABLE",
        "NO_VALID_CANDIDATE",
