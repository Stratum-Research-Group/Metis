    "class_routing": {
      "type": "object",
      "required": [
        "rules",
        "multi_class",
        "unclassified",
        "input_class_normalization",
        "matching"
      ],
      "properties": {
        "rules": {
          "const": [
            {
              "class": "closed_form_number",
              "requires_grounding": true,
              "verifier_active": true,
              "logprobs": true,
              "profile": "grounded_v1"
            },
            {
              "class": "closed_form_number",
              "requires_grounding": true,
              "verifier_active": true,
              "logprobs": false,
              "profile": "grounded_support_only"
            },
            {
              "class": "closed_form_entity",
              "requires_grounding": true,
              "verifier_active": true,
              "logprobs": true,
              "profile": "grounded_v1"
            },
            {
              "class": "closed_form_entity",
              "requires_grounding": true,
              "verifier_active": true,
              "logprobs": false,
              "profile": "grounded_support_only"
            },
            {
              "class": "closed_form_choice",
              "requires_grounding": true,
              "verifier_active": true,
              "logprobs": true,
              "profile": "grounded_v1"
            },
            {
              "class": "closed_form_choice",
              "requires_grounding": true,
              "verifier_active": true,
              "logprobs": false,
              "profile": "grounded_support_only"
            },
            {
              "class": "unclassified",
              "requires_grounding": true,
              "verifier_active": true,
              "profile": "grounded_support_only"
            },
            {
              "class": "*",
              "requires_grounding": true,
              "verifier_active": false,
              "abstain": "VERIFIER_UNAVAILABLE"
            },
            {
              "class": "*",
              "requires_grounding": false,
              "profile": "eligibility_baseline"
            }
          ]
        },
        "multi_class": {
          "const": "normalize each class and route separately; equal profiles combine; unequal grounded profiles are incomparable and abstain PROFILE_UNAVAILABLE; any terminal abstention applies"
        },
        "unclassified": {
          "const": "unknown, empty or missing class normalizes to unclassified before rule matching; grounded requests with active verifier use grounded_support_only"
        },
        "input_class_normalization": {
          "const": {
            "known_classes": [
              "closed_form_number",
              "closed_form_entity",
              "closed_form_choice",
              "unclassified"
            ],
            "unknown_scalar_class": "unclassified",
            "empty_or_missing_class": "unclassified",
            "multi_class": "normalize each member, deduplicate, then combine; conflicting profiles abstain PROFILE_UNAVAILABLE"
          }
        },
        "matching": {
          "const": "omitted boolean field is a wildcard; class * is a wildcard; exactly one rule must match after class normalization"
        }
      },
      "additionalProperties": false
    },
    "n1_handling": {
      "type": "string"
    },
    "budgets": {
      "type": "object"
    },
    "invalidation_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_card": {
      "type": "object",
      "required": [
        "support_false_positive_ucb_target",
        "extraction_recall_min",
        "min_audit_cases",
        "critical_slices",
        "confidence_method",
        "confidence_level",
        "false_support",
        "extraction_recall",
        "slice_gate",
        "gate_tau_coherence",
        "multiple_comparison_control"
      ],
      "properties": {
        "support_false_positive_ucb_target": {
          "$ref": "#/$defs/probability"
        },
        "extraction_recall_min": {
          "$ref": "#/$defs/probability"
        },
        "min_audit_cases": {
          "type": "integer",
          "minimum": 400
        },
        "critical_slices": {
          "const": [
            "multi_claim",
            "negation",
            "quantity",
            "scope",
            "entity_date",
            "hostile_source"
          ]
        },
        "confidence_method": {
          "const": "one-sided exact Clopper-Pearson bounds; Bonferroni family-wise 0.050000 across six critical slices times two metrics"
        },
        "confidence_level": {
          "const": "0.950000"
        },
        "false_support": {
          "type": "object",
          "required": [
            "denominator",
            "numerator",
            "gate",
            "min_eligible_per_slice"
          ],
          "properties": {
            "min_eligible_per_slice": {
              "type": "integer",
              "minimum": 107
            }
          }
        },
        "extraction_recall": {
          "type": "object",
          "required": [
            "denominator",
            "numerator",
            "gate",
            "min_eligible_per_slice"
          ],
          "properties": {
            "min_eligible_per_slice": {
              "type": "integer",
              "minimum": 272
            }
          }
        },
        "slice_gate": {
          "const": "each named critical slice must meet both count minima and both confidence-bound gates; overlapping cases may count in multiple slices; global minimum alone never suffices"
        },
        "gate_tau_coherence": {
          "const": {
            "grounded_support_only": "tau > per_claim_min; 0.850000 > 0.800000",
            "grounded_v1": "tau > w_conf * per_claim_min; 0.700000 > 0.700000 * 0.800000 = 0.560000"
          }
        },
        "multiple_comparison_control": {
          "const": {
            "family_alpha": "0.050000",
            "number_of_gates": 12,
            "per_gate_alpha_fraction": "1/240"
          }
        }
      }
    },
    "retention": {
      "type": "object"
    },
    "candidate_only_reasons": {
      "const": [
        "FEATURE_INVALID"
      ]
    },
    "reason_mapping": {
      "type": "object",
      "required": [
        "candidate_failures",
        "precedence_scope",
        "all_candidates_below_tau",
        "no_candidate_survives_hard_gates_or_feature_checks",
        "no_candidate_generated_after_all_attempts",
        "partial_generation_failure_with_valid_survivor"
      ],
      "properties": {
        "candidate_failures": {
          "const": {
            "access": "NO_AUTHORIZED_CANDIDATE",
            "provenance": "NO_VALID_CANDIDATE",
            "contradiction": "NO_VALID_CANDIDATE",
            "citation_resolution": "NO_VALID_CANDIDATE",
            "per_claim_support": "NO_VALID_CANDIDATE",
            "feature_invalid": "NO_VALID_CANDIDATE"
          }
        },
        "precedence_scope": {
          "const": "terminal abstention only, after routing, hard gates, feature checks and score threshold; never overrides selected survivor"
        },
        "all_candidates_below_tau": {
          "const": "QUALITY_BELOW_THRESHOLD"
        },
        "no_candidate_survives_hard_gates_or_feature_checks": {
          "type": "string",
          "minLength": 1
        },
        "no_candidate_generated_after_all_attempts": {
          "const": "UPSTREAM_GENERATION_FAILED"
        },
        "partial_generation_failure_with_valid_survivor": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "generation_policy": {
      "const": {
        "partial_failure_with_valid_survivor": "select survivor if it passes all gates and tau; log attempts and failures",
        "all_attempts_failed": "abstain UPSTREAM_GENERATION_FAILED"
      }
    }
  },
  "$comment": "Schema for policy 0.1. Frozen numeric operating points and routing/reason tables are version locked; changing them requires a new schema version and sealed audit.",
  "$defs": {
    "probability": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]{6}|1\\.000000)$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{6}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "sealed_test": {
                "properties": {
                  "hash_recorded_before_tuning": {
                    "const": true
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "protocol_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "sealed_at_utc": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "custodian": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "profiles": {
            "properties": {
              "grounded_support_only": {
                "properties": {
                  "per_claim_min": {
                    "const": "0.800000"
                  },
                  "tau": {
                    "const": "0.850000"
                  }
                }
              },
              "grounded_v1": {
                "properties": {
                  "per_claim_min": {
                    "const": "0.800000"
                  },
                  "tau": {
                    "const": "0.700000"
                  },
                  "score": {
                    "properties": {
                      "cal_ll_map": {
                        "properties": {
                          "status": {
                            "const": "validated"
                          },
                          "model_digest": {
                            "$ref": "#/$defs/sha256"
                          },
                          "calibration_dataset_sha256": {
                            "$ref": "#/$defs/sha256"
                          },
                          "calibration_report_sha256": {
                            "$ref": "#/$defs/sha256"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "governance": {
            "properties": {
              "evaluation_claim": {
                "const": "independent_final_test_passed"
              }
            }
          }
        },
        "required": [
          "governance"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "frozen"
          },
          "governance": {
            "properties": {
              "solo_mode": {
                "const": false
              },
              "sealed_test": {
                "properties": {
                  "hash_recorded_before_tuning": {
                    "const": true
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "protocol_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "custodian": {
                    "type": "string",
                    "minLength": 1
                  },
                  "final_test_access_count": {
                    "const": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
