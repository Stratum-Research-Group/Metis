                    }
                  ]
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "formula": {
                          "type": "string",
                          "minLength": 1
                        },
                        "weights": {
